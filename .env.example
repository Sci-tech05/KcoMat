# Copier ce fichier en .env et remplir les valeurs. Ne JAMAIS versionner .env.
SECRET_KEY=your_secret_key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,kcomat0.pythonanywhere.com

# Fedapay
FEDAPAY_API_KEY=your_fedapay_secret_key
FEDAPAY_PUBLIC_KEY=your_fedapay_public_key
FEDAPAY_ENVIRONMENT=sandbox
APP_URL=https://kcomat0.pythonanywhere.com
FEDAPAY_API_TIMEOUT=60

# Domaine Jitsi
JITSI_BASE_URL=https://framatalk.org

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=KcoMat <your_email>

# Admin security
ADMIN_URL=your_admin_path
ADMIN_2FA_PATH=your_admin_path/verify
ADMIN_ALLOWED_IPS=
ADMIN_TRUST_X_FORWARDED_FOR=False
ADMIN_2FA_CODE_TTL_SECONDS=300
ADMIN_2FA_MAX_ATTEMPTS=5

# Notifications push (Web Push / VAPID) : générer avec `python manage.py generer_cles_vapid`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=kcomat0@gmail.com
